    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.28",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
