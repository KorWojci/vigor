{
  "name": "vigor",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted personal health, fitness and body-progress dashboard.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
