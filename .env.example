# Copy to .env and adjust. Placeholder values only — never commit a real .env.

# HTTP port the server listens on.
PORT=3000

# Directory holding the SQLite database and backups. Mount a persistent volume here.
VIGOR_DATA_DIR=./data

# Optional explicit database path (defaults to $VIGOR_DATA_DIR/vigor.db).
# VIGOR_DB_PATH=./data/vigor.db

# Optional: pre-set the dashboard password on first start instead of using the /setup page.
# Only read when no user exists yet. Remove it after the first start.
# VIGOR_ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Set to "true" when Vigor is served over HTTPS (reverse proxy) so session cookies get the Secure flag.
VIGOR_SECURE_COOKIES=false

# Maximum accepted size of a single health import request, in bytes (default 10 MiB).
VIGOR_MAX_IMPORT_BYTES=10485760

# Hours after which Apple Health data is reported as stale (default 3).
VIGOR_STALE_AFTER_HOURS=3

# Disable Next.js telemetry.
NEXT_TELEMETRY_DISABLED=1
